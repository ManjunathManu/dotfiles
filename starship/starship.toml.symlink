# Starship prompt: https://starship.rs/config/
# Linked to ~/.config/starship/starship.toml; STARSHIP_CONFIG in zshrc/bashrc
# points Starship there (it would otherwise look for ~/.config/starship.toml).
#
# Design:
#   - Colors are ANSI names, not hex, so they follow kitty's auto theme
#     (Tokyo Night dark / Modus Operandi light).
#   - AWS `sso` account here (+ "expired"); time stays in the kitty tab bar.
#   - Context only where it matters: language versions in projects that use
#     them, kube context only in Kubernetes folders (red for prod contexts).
#   - Icons are Nerd Font codepoints by name (nerdfonts.com/cheat-sheet).
#
#   lm-commons  master [!2?1] +42 -7 󰏗 v0.1.5 󰎙 22.22.0 󰸏 dev   ✘ 1 took 3s
#   ❯                    (❮ in vi normal mode, red after a failed command)

"$schema" = 'https://starship.rs/config-schema.json'

add_newline = true
command_timeout = 500

format = """
$hostname\
$directory\
$git_branch\
$git_state\
$git_status\
$git_metrics\
$package\
$nodejs\
$python\
$rust\
$golang\
$java\
$terraform\
$docker_context\
$kubernetes\
${env_var.STARSHIP_AWS}\
${env_var.STARSHIP_AWS_EXPIRED}\
${env_var.STARSHIP_AWS_PROD}\
${env_var.STARSHIP_AWS_MPROD}\
$line_break\
$jobs\
$character"""

right_format = "$status$cmd_duration"

# ── Prompt character: vi mode + last exit status ─────────────────────────────
[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
vimcmd_symbol = "[❮](bold green)"
vimcmd_replace_one_symbol = "[❮](bold purple)"
vimcmd_replace_symbol = "[❮](bold purple)"
vimcmd_visual_symbol = "[❮](bold yellow)"

# ── Where am I ───────────────────────────────────────────────────────────────
[hostname]
ssh_only = true
format = "[$hostname](bold yellow) "

[username]
# Only shown as root or over SSH (default); never for the normal local user
format = "[$user]($style)@"

[directory]
truncation_length = 4
truncate_to_repo = true
style = "bold cyan"
repo_root_style = "bold blue"
read_only = " \U000F033E"
read_only_style = "red"

# ── Git ──────────────────────────────────────────────────────────────────────
[git_branch]
symbol = " "
format = "[$symbol$branch(:$remote_branch)]($style) "
style = "bold purple"

[git_state]
# Shown mid-rebase/merge/cherry-pick, e.g. "REBASING 2/5"
style = "bold yellow"

[git_status]
format = '([\[$all_status$ahead_behind\]]($style) )'
style = "bold red"
conflicted = "="
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇡${ahead_count}⇣${behind_count}"
untracked = "?${count}"
stashed = "*${count}"
modified = "!${count}"
staged = "+${count}"
renamed = "»${count}"
deleted = "✘${count}"

[git_metrics]
# Lines added/removed in uncommitted changes, e.g. "+42 -7"
disabled = false
format = "([+$added]($added_style) )([-$deleted]($deleted_style) )"
added_style = "bold green"
deleted_style = "bold red"
only_nonzero_diffs = true
ignore_submodules = true

# ── Project version (package.json, pyproject.toml, Cargo.toml, ...) ─────────
[package]
symbol = "\U000F03D7 "
format = "[$symbol$version]($style) "
style = "bold bright-blue"
# Most internal projects are "private": true; show their version too
display_private = true

# ── Languages: only inside projects that use them ────────────────────────────
[nodejs]
symbol = "\U000F0399 "
format = "[$symbol($version )]($style)"
version_format = "${raw}"
style = "bold green"
detect_files = ["package.json", ".nvmrc", ".node-version"]
detect_extensions = []

[python]
symbol = " "
format = '[$symbol$version( \($virtualenv\))]($style) '
version_format = "${raw}"
style = "bold yellow"
detect_files = [".python-version", "pyproject.toml", "requirements.txt", "setup.py", "Pipfile", "uv.lock"]
detect_extensions = []

[rust]
symbol = " "
format = "[$symbol($version )]($style)"

[golang]
symbol = "\U000F07D3 "
format = "[$symbol($version )]($style)"

[java]
symbol = "\U000F0B37 "
format = "[$symbol($version )]($style)"

[terraform]
symbol = "\U000F1062 "
format = "[$symbol$workspace]($style) "

# ── Containers / clusters: only in folders that use them ─────────────────────
[docker_context]
symbol = " "
format = "[$symbol$context]($style) "
only_with_files = true

[kubernetes]
disabled = false
symbol = "\U000F10FE "
format = '[$symbol$context( \($namespace\))]($style) '
style = "bold blue"
detect_files = ["Chart.yaml", "kustomization.yaml", "skaffold.yaml", "helmfile.yaml"]
detect_folders = ["k8s", "kubernetes", "helm", "charts", "manifests"]

[[kubernetes.contexts]]
# Any context with "prod" in its name: red, so it's hard to miss
context_pattern = ".*prod.*"
style = "bold red"

# ── AWS `sso` account (active / expired) ─────────────────────────────────────
# Text is prepared before each prompt by _starship_aws (bash/zshrc.symlink),
# which sets exactly one of these variables depending on the state.
[env_var.STARSHIP_AWS]
variable = "STARSHIP_AWS"
format = "[$env_value]($style) "
style = "bold green"

[env_var.STARSHIP_AWS_EXPIRED]
variable = "STARSHIP_AWS_EXPIRED"     # run `sso <name>` again
format = "[$env_value]($style) "
style = "bold red"

[env_var.STARSHIP_AWS_PROD]
variable = "STARSHIP_AWS_PROD"        # prod
format = "[$env_value]($style) "
style = "bold yellow"

[env_var.STARSHIP_AWS_MPROD]
variable = "STARSHIP_AWS_MPROD"       # master-prod
format = "[$env_value]($style) "
style = "bold red"

# ── Feedback ─────────────────────────────────────────────────────────────────
[status]
# Exit code of a failed command (right side), with the signal name when
# there is one: "✘ 127", "✘ 130 INT" (Ctrl+C). Hidden after success.
disabled = false
format = "[✘ $status( $signal_name)]($style) "
style = "bold red"
recognize_signal_code = true

[cmd_duration]
min_time = 2_000
format = "[took $duration]($style)"
style = "yellow"
# kitty already notifies for long commands in unfocused windows
show_notifications = false

[jobs]
symbol = "✦"
style = "bold blue"

# ── Off on purpose ───────────────────────────────────────────────────────────
[aws]
disabled = true      # can't read `sso`'s expiry; see env_var.STARSHIP_AWS*
[gcloud]
disabled = true
[time]
disabled = true      # the kitty tab bar shows UTC; macOS shows local time
