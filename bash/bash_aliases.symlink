alias python=python3

alias pip=pip3

alias ..='cd ..';

alias ll='ls -alF'

alias la='ls -A'

alias l='ls -CF'

# ============================================
# MODERN CLI TOOL ALIASES
# ============================================

# eza (modern ls) - only if installed
if command -v eza &> /dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -la --icons --git --group-directories-first'
    alias la='eza -a --icons --group-directories-first'
    alias lt='eza --tree --level=2 --icons'
    alias lta='eza --tree --level=2 --icons --all'
fi

# ripgrep (better grep)
if command -v rg &> /dev/null; then
    alias grep='rg'
fi

# btop (better top)
if command -v btop &> /dev/null; then
    alias top='btop'
fi

# duf (better df)
if command -v duf &> /dev/null; then
    alias df='duf'
fi

# procs (better ps)
if command -v procs &> /dev/null; then
    alias ps='procs'
fi

# bat (better cat)
if command -v bat &> /dev/null; then
    alias cat='bat --paging=never'
    alias catp='bat' # cat with pager
fi

# lazygit
if command -v lazygit &> /dev/null; then
    alias lg='lazygit'
fi

# zoxide (smart cd)
if command -v zoxide &> /dev/null; then
    alias cd='z'
fi

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# Create a new directory and enter it
function mkd() {
    mkdir -p "$@" && cd "$_";
}

# Cd into work
function work() {
  case $@ in
    lisa)
      cd ~/workspace/source-code/lightmetrics/python/chat-knowledge-base;
      ;;

    ttd)
      cd ~/workspace/source-code/lightmetrics/python/conversational-bot;
      ;;

    python)
      cd ~/workspace/source-code/lightmetrics/python;
      ;;

    white)
      cd ~/workspace/source-code/lightmetrics/nodejs/white-label-backend;
      ;;

    aws-utils)
      cd ~/workspace/source-code/lightmetrics/nodejs/aws-utils;
      ;;

    general)
      cd ~/workspace/general
      ;;

    *)
      cd ~/workspace/source-code/lightmetrics;
  esac
}

alias editor='~/editor.sh';

# Update AWS Security group
function sec_grp_update(){
  echo "Trying to update AWS Security group: $1"
  `which node $HOME/workspace/source-code/lightmetrics/nodejs/misc/aws-utils/src/update-sg.js` $1;
}

# Update AWS SSO credentials
function init_aws_sso(){
  echo "Initiating AWS SSO login..."
  `which node` $HOME/workspace/source-code/lightmetrics/nodejs/misc/aws-sso-creds-tool/app.js;
}

