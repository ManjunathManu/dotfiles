# Reload bashrc
alias rbash='source ~/.bashrc'

# ********************** export profile_name ****************************

function exp-aws-profile() {
  h1 "exporting AWS_PROFILE..."
  case $@ in
    dev)
      info "export AWS_PROFILE=Lightmetrics-DevTestAccount-1_AdministratorAccess"
      export AWS_PROFILE=Lightmetrics-DevTestAccount-1_AdministratorAccess
      ;;

    prod)
      info "export AWS_PROFILE=Lightmetrics-ProductionAccount-1_AdministratorAccess"
      export AWS_PROFILE=Lightmetrics-ProductionAccount-1_AdministratorAccess
      ;;

    master-prod)
      info "export AWS_PROFILE=Lightmetrics-MasterProduction_PowerUserAccess"
      export AWS_PROFILE=Lightmetrics-MasterProduction_PowerUserAccess
      ;;

    operations)
      info "export AWS_PROFILE=Lightmetrics-OperationsAccount-1_AdministratorAccess"
      export AWS_PROFILE=Lightmetrics-OperationsAccount-1_AdministratorAccess
      ;;

    *)
      error "Invalid profile name: only [dev, prod, master-prod, operations] is allowed"
      ;;
  esac
}

alias chrome="open -a 'Google Chrome'"

# ******************* Claude code ************************
alias cc='claude'

fetch_ssm_to_env() {
  # Ask for base path
  read -p "Enter Parameter Store base path (e.g., /apistack-prod_usw2/llm-kb-db-api-server-qa/common/): " base_path

  if [ -z "$base_path" ]; then
    echo "Error: Parameter store base path cannot be empty"
    return 1
  fi

  # Ask for region
  read -p "Enter AWS region (e.g., us-west-2): " region

  if [ -z "$region" ]; then
    echo "Error: AWS region cannot be empty"
    return 1
  fi

  echo ""
  echo "Fetching parameters from ${base_path} in region ${region}..."
  echo "----"

  aws ssm get-parameters-by-path \
    --path "${base_path}" \
    --with-decryption \
    --output text \
    --region "$region" | sort | awk '{ sub("^.*/", "", $5); print $5"="$7 }'

  echo "----"
  if [ $? -eq 0 ]; then
    echo "Successfully fetched parameters"
  else
    echo "Error: Failed to fetch parameters"
    return 1
  fi
}

### use a profile and export its creds
sso() {
  local profile="$1"

  if [ -z "$profile" ]; then
    echo "Usage: sso <profile-name>"
    return 1
  fi

  echo "🔍 Checking credentials..."

  if ! aws sts get-caller-identity --profile "$profile" --output json >/dev/null 2>&1; then
    echo "🔑 SSO session missing or expired. Logging in..."
    if ! aws sso login --profile "$profile"; then
      echo "❌ Failed to login to AWS SSO"
      return 1
    fi
  else
    echo "✅ SSO session already active."
  fi
  # local res="$(aws configure export-credentials --profile "$profile" --format env)"
  # echo res
  eval "$(aws configure export-credentials --profile "$profile" --format env)"
  echo "✅ AWS credentials exported for profile: $profile"
}
