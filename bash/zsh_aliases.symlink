# Create a new directory and enter it
function mkd() {
    mkdir -p "$@" && cd "$_";
}

# Cd into work
function work() {
  case $@ in
    lisa)
      cd ~/workspace/source-code/lightmetrics/python/chat-knowledge-base;
      ;;

    ttd)
      cd ~/workspace/source-code/lightmetrics/python/conversational-bot;
      ;;

    python)
      cd ~/workspace/source-code/lightmetrics/python;
      ;;

    white)
      cd ~/workspace/source-code/lightmetrics/nodejs/white-label-backend;
      ;;

    aws-utils)
      cd ~/workspace/source-code/lightmetrics/nodejs/aws-utils;
      ;;

    general)
      cd ~/workspace/general
      ;;

    *)
      cd ~/workspace/source-code/lightmetrics;
  esac
}

