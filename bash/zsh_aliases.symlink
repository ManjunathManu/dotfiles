# *****************GIT HOOKS*******************

# `pre-commit install` refuses while the global core.hooksPath is set (the
# gitleaks dispatcher in git/git-hooks.symlink). Install into .git/hooks
# anyway: the dispatcher runs it after gitleaks.
pre-commit() {
  if [[ $1 == install ]]; then
    GIT_CONFIG_GLOBAL=/dev/null command pre-commit "$@"
  else
    command pre-commit "$@"
  fi
}

