alias cc='claude'

##########################################################

fetch_ssm_to_env() {
  # Ask for base path
  read -r "base_path?Enter Parameter Store base path (e.g., /my-app/prod/common/): "

  if [ -z "$base_path" ]; then
    echo "Error: Parameter store base path cannot be empty"
    return 1
  fi

  # Ask for region
  read -r "region?Enter AWS region (e.g., us-west-2): "

  if [ -z "$region" ]; then
    echo "Error: AWS region cannot be empty"
    return 1
  fi

  echo ""
  echo "Fetching parameters from ${base_path} in region ${region}..."
  echo "----"

  aws ssm get-parameters-by-path \
    --path "${base_path}" \
    --with-decryption \
    --output text \
    --region "$region" | sort | awk '{ sub("^.*/", "", $5); print $5"="$7 }'

  echo "----"
  if [ $? -eq 0 ]; then
    echo "Successfully fetched parameters"
  else
    echo "Error: Failed to fetch parameters"
    return 1
  fi
}

### use a profile and export its creds
sso() {
  local profile="$1"

  if [ -z "$profile" ]; then
    echo "Usage: sso <profile-name>"
    return 1
  fi

  echo "🔍 Checking credentials..."

  if ! aws sts get-caller-identity --profile "$profile" --output json >/dev/null 2>&1; then
    echo "🔑 SSO session missing or expired. Logging in..."
    if ! aws sso login --profile "$profile"; then
      echo "❌ Failed to login to AWS SSO"
      return 1
    fi
  else
    echo "✅ SSO session already active."
  fi
  # local res="$(aws configure export-credentials --profile "$profile" --format env)"
  # echo res
  eval "$(aws configure export-credentials --profile "$profile" --format env)"
  # Short name (dev/prod/mprod) for the kitty tab bar; expiry comes from
  # AWS_CREDENTIAL_EXPIRATION, which export-credentials sets above
  export AWS_SSO_NAME="$profile"
  echo "✅ AWS credentials exported for profile: $profile"
}

# ********************** AWS TEAM Elevated Access ****************************

team-request() {
  local justification="${1}"
  local duration="${2:-4}"

  if [ -z "$justification" ]; then
    error "Usage: team-request <justification> [duration_hours]"
    return 1
  fi
  if [ -z "$TEAM_URL" ]; then
    error "TEAM settings missing: create config/aws.local.sh from config/aws.example.sh"
    return 1
  fi

  h1 "AWS TEAM Elevated Access Request"
  info "Account:        $TEAM_ACCOUNT_ID"
  info "Permission Set: $TEAM_PERMSET"
  info "Duration:       ${duration}h"
  info "Justification:  $justification"
  info "Ticket:         $TEAM_TICKET"

  # Delegate to automation script if available (reads the same config)
  local script="$DOTFILES_DIR/bin/team-request"
  if [ -x "$script" ]; then
    "$script" "$justification" "$duration"
    return $?
  fi

  # Fallback: open browser
  info "Opening TEAM portal in browser..."
  open "$TEAM_URL"
  echo ""
  info "After submitting the request, run: team-activate"
}

team-activate() {
  h1 "Activating TEAM elevated access..."
  sso "$TEAM_SSO_PROFILE"
  if [ $? -eq 0 ]; then
    success "TEAM elevated access is active"
    aws sts get-caller-identity --output table
  fi
}

# Python virtual environment activation shortcut
venv() {
  if [ -f "./venv/bin/activate" ]; then
    source ./venv/bin/activate
    echo "Activated venv"
  elif [ -f "./.venv/bin/activate" ]; then
    source ./.venv/bin/activate
    echo "Activated .venv"
  else
    echo "No virtual environment found (checked ./venv and ./.venv)"
    return 1
  fi
}

