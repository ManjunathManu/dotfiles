fetch_ssm_to_env() {
  # Ask for base path
  read -r "base_path?Enter Parameter Store base path (e.g., /my-app/prod/common/): "

  if [ -z "$base_path" ]; then
    echo "Error: Parameter store base path cannot be empty"
    return 1
  fi

  # Ask for region
  read -r "region?Enter AWS region (e.g., us-west-2): "

  if [ -z "$region" ]; then
    echo "Error: AWS region cannot be empty"
    return 1
  fi

  echo ""
  echo "Fetching parameters from ${base_path} in region ${region}..."
  echo "----"

  aws ssm get-parameters-by-path \
    --path "${base_path}" \
    --with-decryption \
    --output text \
    --region "$region" | sort | awk '{ sub("^.*/", "", $5); print $5"="$7 }'

  echo "----"
  if [ $? -eq 0 ]; then
    echo "Successfully fetched parameters"
  else
    echo "Error: Failed to fetch parameters"
    return 1
  fi
}

### use a profile and export its creds
sso() {
  local profile="$1"

  if [ -z "$profile" ]; then
    echo "Usage: sso <profile-name>"
    return 1
  fi

  echo "🔍 Checking credentials..."

  if ! aws sts get-caller-identity --profile "$profile" --output json >/dev/null 2>&1; then
    echo "🔑 SSO session missing or expired. Logging in..."
    if ! aws sso login --profile "$profile"; then
      echo "❌ Failed to login to AWS SSO"
      return 1
    fi
  else
    echo "✅ SSO session already active."
  fi
  # local res="$(aws configure export-credentials --profile "$profile" --format env)"
  # echo res
  eval "$(aws configure export-credentials --profile "$profile" --format env)"
  # Short name (dev/prod/mprod) for the kitty tab bar; expiry comes from
  # AWS_CREDENTIAL_EXPIRATION, which export-credentials sets above
  export AWS_SSO_NAME="$profile"
  echo "✅ AWS credentials exported for profile: $profile"
}

# Hint (never logs in by itself) when this shell has no valid `sso` credentials.
# Called by the enter hook in mise/lightmetrics.mise.toml when you cd into a
# work repo. Usage: _aws_sso_hint [suggested-profile]
_aws_sso_hint() {
  local want=${1:-dev} expires now
  if [[ -z $AWS_SSO_NAME ]]; then
    print -P "%F{yellow}AWS:%f no sso credentials in this shell. Run: %Bsso $want%b (or prod / mprod)"
    return
  fi
  [[ -z $AWS_CREDENTIAL_EXPIRATION ]] && return
  zmodload zsh/datetime
  # AWS_CREDENTIAL_EXPIRATION is UTC ISO-8601, e.g. 2026-10-02T10:21:03+00:00
  TZ=UTC strftime -r -s expires '%Y-%m-%dT%H:%M:%S' "${AWS_CREDENTIAL_EXPIRATION[1,19]}" 2>/dev/null || return
  now=$EPOCHSECONDS
  if (( expires <= now )); then
    local mins=$(( (now - expires) / 60 )) ago
    if (( mins < 120 )); then ago="${mins}m"; elif (( mins < 2880 )); then ago="$(( mins / 60 ))h"; else ago="$(( mins / 1440 ))d"; fi
    print -P "%F{red}AWS:%f sso $AWS_SSO_NAME credentials expired $ago ago. Run: %Bsso $AWS_SSO_NAME%b"
  fi
}

# Load the current repo's .env into this shell while you're inside it (mise
# unsets it again when you leave). Writes mise.local.toml, which mise reads
# but which never gets committed (added to .git/info/exclude, not .gitignore).
#   mise-env          enable for this repo
#   mise-env off      disable
mise-env() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "mise-env: not inside a git repo"; return 1; }
  local cfg="$root/mise.local.toml" exclude="$(git -C "$root" rev-parse --git-common-dir)/info/exclude"
  if [[ $1 == off ]]; then
    [[ -f $cfg ]] && rm "$cfg" && echo "mise-env: removed ${cfg/#$HOME/~}" || echo "mise-env: not enabled here"
    eval "$(mise hook-env -s zsh)"
    return
  fi
  [[ -f "$root/.env" ]] || { echo "mise-env: no .env in ${root/#$HOME/~}"; return 1; }
  if [[ -f $cfg ]]; then
    echo "mise-env: ${cfg/#$HOME/~} already exists, leaving it as is"
  else
    printf '# Created by `mise-env` (dotfiles). Loads .env while inside this repo.\n[env]\n_.file = { path = ".env", redact = true }\n' > "$cfg"
  fi
  mkdir -p "${exclude:h}"
  # `command grep`: plain grep may be aliased (e.g. to ripgrep)
  command grep -qxF 'mise.local.toml' "$exclude" 2>/dev/null || echo 'mise.local.toml' >> "$exclude"
  mise trust --quiet "$cfg" && eval "$(mise hook-env -s zsh)"
  echo "mise-env: .env loaded for ${root:t} ($(command grep -cE '^(export )?[A-Za-z_][A-Za-z0-9_]*=' "$root/.env") variables; values not shown)"
}

# ********************** AWS TEAM Elevated Access ****************************

team-request() {
  local justification="${1}"
  local duration="${2:-4}"

  if [ -z "$justification" ]; then
    error "Usage: team-request <justification> [duration_hours]"
    return 1
  fi
  if [ -z "$TEAM_URL" ]; then
    error "TEAM settings missing: create config/aws.local.sh from config/aws.example.sh"
    return 1
  fi

  h1 "AWS TEAM Elevated Access Request"
  info "Account:        $TEAM_ACCOUNT_ID"
  info "Permission Set: $TEAM_PERMSET"
  info "Duration:       ${duration}h"
  info "Justification:  $justification"
  info "Ticket:         $TEAM_TICKET"

  # Delegate to automation script if available (reads the same config)
  local script="$DOTFILES_DIR/bin/team-request"
  if [ -x "$script" ]; then
    "$script" "$justification" "$duration"
    return $?
  fi

  # Fallback: open browser
  info "Opening TEAM portal in browser..."
  open "$TEAM_URL"
  echo ""
  info "After submitting the request, run: team-activate"
}

team-activate() {
  h1 "Activating TEAM elevated access..."
  sso "$TEAM_SSO_PROFILE"
  if [ $? -eq 0 ]; then
    success "TEAM elevated access is active"
    aws sts get-caller-identity --output table
  fi
}

# Python virtual environment activation shortcut
venv() {
  if [ -f "./venv/bin/activate" ]; then
    source ./venv/bin/activate
    echo "Activated venv"
  elif [ -f "./.venv/bin/activate" ]; then
    source ./.venv/bin/activate
    echo "Activated .venv"
  else
    echo "No virtual environment found (checked ./venv and ./.venv)"
    return 1
  fi
}

