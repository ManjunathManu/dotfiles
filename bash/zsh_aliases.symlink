# ********************** AWS config ****************************

# Account-specific values (profiles, TEAM settings) live in the gitignored
# config/aws.local.sh; see config/aws.example.sh for the template.
DOTFILES_DIR="${${:-$HOME/.zsh_aliases}:A:h:h}"   # resolve symlink → repo root, no subshells
[ -f "$DOTFILES_DIR/config/aws.local.sh" ] && . "$DOTFILES_DIR/config/aws.local.sh"

# ********************** export profile_name ****************************

function exp-aws-profile() {
  h1 "exporting AWS_PROFILE..."
  local profile
  case $@ in
    dev)         profile="$AWS_PROFILE_DEV" ;;
    prod)        profile="$AWS_PROFILE_PROD" ;;
    master-prod) profile="$AWS_PROFILE_MASTER_PROD" ;;
    operations)  profile="$AWS_PROFILE_OPERATIONS" ;;
    *)
      error "Invalid profile name: only [dev, prod, master-prod, operations] is allowed"
      return 1
      ;;
  esac

  if [ -z "$profile" ]; then
    error "Profile for '$*' is not set in config/aws.local.sh"
    return 1
  fi
  info "export AWS_PROFILE=$profile"
  export AWS_PROFILE="$profile"
}

