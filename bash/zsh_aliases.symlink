# Update AWS Security group
function sec_grp_update(){
  echo "Trying to update AWS Security group: $1"
  `which node $HOME/workspace/source-code/lightmetrics/nodejs/misc/aws-utils/src/update-sg.js` $1;
}

# *****************UPKEEP*******************

# What has updates (brew, mise, pre-commit hooks)? Reports only. Also runs
# monthly via launchd (launchd/dev.dotfiles.upkeep.plist) with a notification.
alias upkeep='"$DOTFILES_DIR/bin/upkeep"'

# *****************GIT HOOKS*******************

# `pre-commit install` refuses while the global core.hooksPath is set (the
# gitleaks dispatcher in git/git-hooks.symlink). Install into .git/hooks
# anyway: the dispatcher runs it after gitleaks.
pre-commit() {
  if [[ $1 == install ]]; then
    GIT_CONFIG_GLOBAL=/dev/null command pre-commit "$@"
  else
    command pre-commit "$@"
  fi
}

