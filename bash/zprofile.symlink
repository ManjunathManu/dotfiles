# export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# Cached `eval "$(tool init)"` helper (see bash/zsh_cache.zsh)
source "${${(%):-%x}:A:h}/zsh_cache.zsh"

_cached_source brew-shellenv /opt/homebrew/bin/brew /opt/homebrew/bin/brew shellenv zsh \
    || eval "$(/opt/homebrew/bin/brew shellenv)"

# Add Visual Studio Code (code)
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# export PATH="/opt/homebrew/opt/node@14/bin:$PATH"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
# One cached `pyenv init -` (it already sets up PATH, so `init --path` was a
# duplicate). --no-rehash: shims are rebuilt by `pyenv install` / pip, not per shell.
_cached_source pyenv-init pyenv pyenv init - --no-rehash zsh || eval "$(pyenv init - zsh)"

# Load machine-local secrets (not tracked in git)
[ -f ~/.secrets ] && . ~/.secrets

# uv
export PATH="/Users/manju/.local/bin:$PATH"
