# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# ============================================
# ZSH PLUGINS (Manual Loading)
# ============================================

# Plugin directory
ZSH_PLUGIN_DIR="${HOME}/.zsh-plugins"

# Install plugins if not present
if [ ! -d "$ZSH_PLUGIN_DIR" ]; then
    mkdir -p "$ZSH_PLUGIN_DIR"
fi

# Install fast-syntax-highlighting
if [ ! -d "$ZSH_PLUGIN_DIR/fast-syntax-highlighting" ]; then
    git clone https://github.com/zdharma-continuum/fast-syntax-highlighting.git "$ZSH_PLUGIN_DIR/fast-syntax-highlighting"
fi

# Install zsh-autosuggestions
if [ ! -d "$ZSH_PLUGIN_DIR/zsh-autosuggestions" ]; then
    git clone https://github.com/zsh-users/zsh-autosuggestions.git "$ZSH_PLUGIN_DIR/zsh-autosuggestions"
fi

# Install zsh-completions
if [ ! -d "$ZSH_PLUGIN_DIR/zsh-completions" ]; then
    git clone https://github.com/zsh-users/zsh-completions.git "$ZSH_PLUGIN_DIR/zsh-completions"
fi

# Install fzf-tab
if [ ! -d "$ZSH_PLUGIN_DIR/fzf-tab" ]; then
    git clone https://github.com/Aloxaf/fzf-tab.git "$ZSH_PLUGIN_DIR/fzf-tab"
fi

# Add homebrew completions to fpath (needed for non-login shells like tmux panes)
if [[ -d /opt/homebrew/share/zsh/site-functions ]]; then
    fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
fi

# Add zsh-completions to fpath
fpath=($ZSH_PLUGIN_DIR/zsh-completions/src $fpath)

# Cached `eval "$(tool init)"` helper (see bash/zsh_cache.zsh)
source "${${(%):-%x}:A:h}/zsh_cache.zsh"

# Initialize completion system BEFORE loading plugins
# -i: silently ignore insecure directories (common on macOS with homebrew)
# Full check + dump rebuild at most once a day; otherwise -C reuses the dump
# (~470ms → ~30ms). New completions show up within 24h, or run: rm ~/.zcompdump
autoload -Uz compinit
() {
    setopt local_options extended_glob
    local dump=${ZDOTDIR:-$HOME}/.zcompdump
    if [[ -f $dump && -z $dump(#qN.mh+24) ]]; then
        compinit -C -i -d "$dump"
    else
        compinit -i -d "$dump"
    fi
}
autoload -U +X bashcompinit && bashcompinit

# Vi mode, set explicitly. zsh only auto-picks vi mode if $EDITOR/$VISUAL
# contains "vi" when the first `bindkey` runs. EDITOR is exported further
# down, so this only worked when the parent (e.g. tmux) already had EDITOR=vim.
# Must stay before the plugins and any other bindkey below.
bindkey -v
# Esc → normal mode after 10ms instead of 400ms
KEYTIMEOUT=1

# Load plugins in correct order:
# fzf-tab must be after compinit but before autosuggestions and syntax highlighting
source "$ZSH_PLUGIN_DIR/fzf-tab/fzf-tab.plugin.zsh" 2>/dev/null
source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" 2>/dev/null
source "$ZSH_PLUGIN_DIR/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh" 2>/dev/null

# Configure autosuggestions
export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#666666"
export ZSH_AUTOSUGGEST_STRATEGY=(history completion)
export ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
bindkey '^ ' autosuggest-accept  # Ctrl+Space to accept

# Fix backspace in middle of line (iTerm2 + tmux compatibility)
bindkey '^?' backward-delete-char
bindkey '^H' backward-delete-char

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
# shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
# shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.

#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt

#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
  # We have color support; assume it's compliant with Ecma-48
  # (ISO/IEC-6429). (Lack of such support is extremely rare, and such
  # a case would tend to support setf rather than setaf.)
  color_prompt=yes
    else
  color_prompt=
    fi
fi

# Function to parse Git branch
function parse_git_branch() {
    git branch 2> /dev/null | sed -n -e 's/^\* \(.*\)/[\1]/p'
}

# Fish-style shortened directory path
function prompt_short_dir() {
    local dir="${PWD/#$HOME/~}"
    local parts=("${(@s:/:)dir}")
    local result=""

    # If we're in home directory, just show ~
    if [[ "$dir" == "~" ]]; then
        echo "~"
        return
    fi

    # Build shortened path
    for i in {1..$((${#parts[@]}-1))}; do
        if [[ -n "${parts[$i]}" ]]; then
            result+="${parts[$i]:0:1}/"
        fi
    done

    # Add the last directory (full name)
    result+="${parts[-1]}"
    echo "$result"
}

# Initialize Starship prompt if available, otherwise use traditional prompt
if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
else
    # Traditional prompt fallback
    COLOR_DEF=$'%f'
    COLOR_USR=$'%F{green}'
    COLOR_DIR=$'%F{blue}'
    COLOR_GIT=$'%F{yellow}'
    setopt PROMPT_SUBST
    export PROMPT='${COLOR_USR}%n ${COLOR_DIR}$(prompt_short_dir)${COLOR_GIT} $(parse_git_branch)${COLOR_DEF}$ '
fi

# Tell kitty which `sso <name>` this window used (and when those credentials
# expire) before each prompt, so the custom tab bar (kitty/tab_bar.py) can show
# "dev · 52m" and turn red for prod. Uses kitty user vars:
# OSC 1337 SetUserVar=<name>=<base64 value>; no value unsets it.
if [[ "$TERM" == "xterm-kitty" ]]; then
    _kitty_user_var() {
        if [[ -n "$2" ]]; then
            printf '\e]1337;SetUserVar=%s=%s\a' "$1" "$(printf %s "$2" | base64)"
        else
            printf '\e]1337;SetUserVar=%s\a' "$1"
        fi
    }
    _kitty_sync_user_vars() {
        _kitty_user_var aws_sso "$AWS_SSO_NAME"
        _kitty_user_var aws_expires "$AWS_CREDENTIAL_EXPIRATION"
    }
    precmd_functions+=(_kitty_sync_user_vars)
fi

# if [ "$color_prompt" = yes ]; then
  # PROMPT='%F{green}%n@%m%f:%F{blue}%~%u$(parse_git_branch)%F{yellow}%f% $ '
# else
  # PROMPT='${debian_chroot:+($debian_chroot)}%n@%m:%~$(parse_git_branch)$ '
# fi
# unset color_prompt force_color_prompt

# precmd() {
  # PS1="%n@%M:%~\$(parse_git_branch)%# "
# }

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
# export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
# Use Vim as default editor
export VISUAL=vim
export EDITOR="$VISUAL"

# git diff (delta) colors follow macOS appearance, like kitty's auto themes.
# Checked at shell start (~17ms); "+" adds to the features set in gitconfig.
if [[ "$OSTYPE" == darwin* && "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" != "Dark" ]]; then
    export DELTA_FEATURES="+modus-operandi"
fi

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.zsh_aliases ]; then
    source ~/.zsh_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
# if ! shopt -oq posix; then
#   if [ -f /usr/share/bash-completion/bash_completion ]; then
#     . /usr/share/bash-completion/bash_completion
#   elif [ -f /etc/bash_completion ]; then
#     . /etc/bash_completion
#   fi
# fi

confirm() {
  # call with a prompt string or use a default
  read -r "response?${1:-Are you sure? [y/N]} "
  case "$response" in
    [yY][eE][sS]|[yY])
      true
      ;;
    *)
      false
      ;;
  esac
}

replicator ()
{
  ~/workspace/source-code/lightmetrics/couchdb_feeds/process/replicator.sh $@
}
complete -F _replicator replicator
alias ic="ibmcloud"
# work  # Commented out - call manually when needed

if command -v terraform &> /dev/null; then
    complete -C "$(which terraform)" terraform
fi

complete -C '/usr/local/bin/aws_completer' aws

