source ~/workspace/source-code/personal/dotfiles/utils.sh

# export PATH="/usr/node-v18.15.0/bin:$PATH"

# mise: Node + Python versions (replaced nvm + pyenv). Global defaults live in
# mise/config.toml.symlink; projects switch automatically on `cd` via mise.toml,
# .nvmrc or .python-version.
# Not cached (~26ms live): `mise activate` embeds the current $PATH in its
# output, so a cached copy would freeze an old PATH into every new shell.
if (( $+commands[mise] )); then
    eval "$(mise activate zsh)"
fi

# Point old habits at the new tool
nvm() {
    print -u2 "nvm was replaced by mise. Equivalents:"
    print -u2 "  nvm use 20        → mise use node@20      (this project: writes mise.toml)"
    print -u2 "  nvm install 20    → mise install node@20"
    print -u2 "  nvm ls            → mise ls node"
    print -u2 "  nvm alias default → edit ~/.config/mise/config.toml (or: mise use -g node@20)"
    return 1
}


# Load Angular CLI autocompletion (cached; regenerated when ng is upgraded).
if (( $+commands[ng] )); then
    _cached_source ng-completion ng ng completion script
fi

# SSH autocompletion for zsh
_ssh_hosts() {
    local -a ssh_hosts
    if [[ -f ~/.ssh/config ]]; then
        ssh_hosts=(${${${${(@M)${(f)"$(cat ~/.ssh/config ~/.ssh/config.d/* 2>/dev/null)"}:#Host *}#Host }:#*[*?]*}})
    fi
    _describe 'ssh hosts' ssh_hosts
}
compdef _ssh_hosts ssh

# Git completion for zsh
if [ -f ~/.git-completion.zsh ]; then
    source ~/.git-completion.zsh
fi

# Kubectl completion for zsh (cached; regenerated when kubectl is upgraded)
if (( $+commands[kubectl] )); then
    _cached_source kubectl-completion kubectl kubectl completion zsh
    alias k=kubectl
    compdef k=kubectl
fi

# uv
export PATH="/Users/manju/.local/bin:$PATH"

# ============================================
# ENHANCED TERMINAL FEATURES
# ============================================

# Initialize zoxide (smart cd) if available
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

# Load enhanced zsh configuration
if [ -f ~/.enhanced_zsh ]; then
    source ~/.enhanced_zsh
fi

# atuin: searchable history on Ctrl+R (and `/` in vi normal mode). Must stay
# after ~/.enhanced_zsh, which loads fzf's Ctrl+R binding; the last one wins.
# --disable-up-arrow: Up keeps zsh's normal behavior.
# --disable-ai: `?` stays a normal key (atuin AI sends input to a web service).
# Config: atuin/config.toml.symlink
if (( $+commands[atuin] )); then
    eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
fi
