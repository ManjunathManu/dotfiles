-- Neovim Configuration with lazy.nvim
-- Modern LSP-based setup to complement existing Vim configuration
-- This provides a parallel Neovim setup for testing modern features

-- Set leader key early (before lazy.nvim)
vim.g.mapleader = " "
vim.g.maplocalleader = " "

-- Bootstrap lazy.nvim plugin manager
local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"
if not vim.loop.fs_stat(lazypath) then
  vim.fn.system({
    "git",
    "clone",
    "--filter=blob:none",
    "https://github.com/folke/lazy.nvim.git",
    "--branch=stable",
    lazypath,
  })
end
vim.opt.rtp:prepend(lazypath)

-- Load core configurations
require("options")
require("keymaps")
require("plugins")

-- Set colorscheme (will be provided by plugin)
vim.cmd.colorscheme("tokyonight-night")
