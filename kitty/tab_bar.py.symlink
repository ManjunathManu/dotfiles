# Custom kitty tab bar: powerline tabs on the left, tmux-style status on the right.
# Linked to ~/.config/kitty/tab_bar.py; enabled by `tab_bar_style custom` in kitty.conf.
#
# Segments (right side): load · local IP · UTC timestamp
#   load  1-minute load average, colored by load per CPU core.
# (The AWS `sso` account + expiry is in the Starship prompt, starship.toml.)
# Everything runs on kitty's timer (no threads) and makes no network calls.
# A segment shows "–" when its lookup fails, instead of disappearing.
# Errors here make kitty fall back to the default tab bar.

import datetime
import os
import re
import subprocess
import time

from kitty.fast_data_types import Screen, add_timer, get_boss, get_options
from kitty.tab_bar import (
    DrawData,
    ExtraData,
    TabBarData,
    as_rgb,
    draw_tab_with_powerline,
)
from kitty.utils import color_as_int

# ── Settings ────────────────────────────────────────────────────────────────

REFRESH_SECONDS = 1          # redraw interval (UTC seconds, load)
LOCAL_IP_SECONDS = 30        # local IP check interval

# Order of segments on the right; remove names to hide them
SEGMENTS = ["load", "local_ip", "utc"]
# When the window is too narrow, hide segments in this order
DROP_ORDER = ["local_ip", "load", "utc"]

# Nerd Font icons (JetBrainsMono Nerd Font). Names from nerdfonts.com/cheat-sheet
ICON_LOAD = "\U000f04c5"      # md-speedometer
ICON_LAN = "\U000f0a5f"       # md-ip
ICON_WORLD = "\U000f01e7"     # md-earth
SEPARATOR = ""          # ple-left_half_circle_thick

# ── Data (refreshed from the timer, on kitty's main thread) ─────────────────

_state: dict = {"local_ip": ""}
_next = {"local_ip": 0.0}


def _run(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=1).stdout
    except Exception:
        return ""


def _local_ip() -> str:
    m = re.search(r"interface:\s*(\S+)", _run("/sbin/route", "-n", "get", "default"))
    # Default route may be a VPN tunnel (utun*) with no IPv4 → try Wi-Fi/Ethernet too
    ifaces = ([m.group(1)] if m else []) + [f"en{i}" for i in range(5)]
    for iface in ifaces:
        ip = _run("/usr/sbin/ipconfig", "getifaddr", iface).strip()
        if ip:
            return ip
    return ""


def _refresh() -> None:
    now = time.monotonic()

    if now >= _next["local_ip"]:
        _state["local_ip"] = _local_ip()
        _next["local_ip"] = now + LOCAL_IP_SECONDS


def _tick(timer_id: int | None) -> None:
    _refresh()
    for tm in get_boss().all_tab_managers:
        tm.mark_tab_bar_dirty()


_timer_id = None

# ── Rendering ───────────────────────────────────────────────────────────────

# A segment is (name, text, fg, bg); bg None = default segment background
Segment = tuple[str, str, int, int | None]


def _load_segment(c) -> Segment:
    load = os.getloadavg()[0]
    per_core = load / (os.cpu_count() or 1)
    fg = c(2) if per_core < 0.7 else c(3) if per_core < 1.0 else c(1)
    return ("load", f"{ICON_LOAD} {load:.2f}", fg, None)


def _segments() -> list[Segment]:
    opts = get_options()
    c = lambda n: color_as_int(getattr(opts, f"color{n}"))  # noqa: E731
    now = datetime.datetime.now(datetime.timezone.utc)
    parts: dict[str, Segment | None] = {
        "load": _load_segment(c),
        "local_ip": ("local_ip", f"{ICON_LAN} {_state['local_ip'] or '–'}", c(4), None),
        "utc": ("utc", f"{ICON_WORLD} {now:%Y-%m-%d %H:%M:%S} UTC", c(6), None),
    }
    return [s for name in SEGMENTS if (s := parts.get(name))]


def _draw_right_status(draw_data: DrawData, screen: Screen) -> None:
    segments = _segments()
    bar_bg = as_rgb(color_as_int(draw_data.default_bg))
    seg_bg = color_as_int(draw_data.inactive_bg)

    # Each segment: separator + " text "
    def width(segs):
        return sum(len(s[1]) + 3 for s in segs)

    # Too narrow: hide the least important segments first
    min_x = screen.cursor.x + 2
    for name in DROP_ORDER:
        if screen.columns - width(segments) >= min_x:
            break
        segments = [s for s in segments if s[0] != name]
    if not segments or screen.columns - width(segments) < min_x:
        return

    screen.cursor.x = screen.columns - width(segments)
    for _, text, fg, bg in segments:
        bg = seg_bg if bg is None else bg
        screen.cursor.bg = bar_bg
        screen.cursor.fg = as_rgb(bg)
        screen.draw(SEPARATOR)
        screen.cursor.bg = as_rgb(bg)
        screen.cursor.fg = as_rgb(fg)
        screen.draw(f" {text} ")
    screen.cursor.bg = bar_bg


def draw_tab(
    draw_data: DrawData,
    screen: Screen,
    tab: TabBarData,
    before: int,
    max_title_length: int,
    index: int,
    is_last: bool,
    extra_data: ExtraData,
) -> int:
    global _timer_id
    if _timer_id is None:
        _refresh()
        _timer_id = add_timer(_tick, REFRESH_SECONDS, True)

    end = draw_tab_with_powerline(
        draw_data, screen, tab, before, max_title_length, index, is_last, extra_data
    )
    if is_last and not extra_data.for_layout:
        _draw_right_status(draw_data, screen)
    return end
