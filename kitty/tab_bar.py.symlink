# Custom kitty tab bar: powerline tabs on the left, tmux-style status on the right.
# Linked to ~/.config/kitty/tab_bar.py; enabled by `tab_bar_style custom` in kitty.conf.
#
# Segments (right side): AWS · load · local IP · UTC timestamp
#   AWS   name from `sso dev|prod|mprod` in the focused split + time left on
#         those credentials (both sent as kitty user vars by a zsh precmd hook
#         in zshrc). Hidden where `sso` wasn't run. Red background for prod.
#   load  1-minute load average, colored by load per CPU core.
# Everything runs on kitty's timer (no threads) and makes no network calls.
# A segment shows "–" when its lookup fails, instead of disappearing.
# Errors here make kitty fall back to the default tab bar.

import datetime
import os
import re
import subprocess
import time

from kitty.fast_data_types import Screen, add_timer, get_boss, get_options
from kitty.tab_bar import (
    DrawData,
    ExtraData,
    TabBarData,
    as_rgb,
    draw_tab_with_powerline,
)
from kitty.utils import color_as_int

# ── Settings ────────────────────────────────────────────────────────────────

REFRESH_SECONDS = 1          # redraw interval (UTC seconds, load, AWS)
LOCAL_IP_SECONDS = 30        # local IP check interval
CREDS_WARN_MINUTES = 10      # AWS credentials turn yellow below this
PROD_PATTERN = re.compile(r"prod", re.IGNORECASE)   # matches prod, mprod
# Segment background per prod account; other prod matches (mprod) use theme red
PROD_BACKGROUNDS = {"prod": 0xF9E2AF}               # light yellow

# Order of segments on the right; remove names to hide them
SEGMENTS = ["aws", "load", "local_ip", "utc"]
# When the window is too narrow, hide segments in this order
DROP_ORDER = ["local_ip", "load", "utc", "aws"]

# Nerd Font icons (JetBrainsMono Nerd Font). Names from nerdfonts.com/cheat-sheet
ICON_AWS = "\U000f0e0f"       # md-aws
ICON_LOAD = "\U000f04c5"      # md-speedometer
ICON_LAN = "\U000f0a5f"       # md-ip
ICON_WORLD = "\U000f01e7"     # md-earth
SEPARATOR = ""          # ple-left_half_circle_thick

# ── Data (refreshed from the timer, on kitty's main thread) ─────────────────

_state: dict = {"local_ip": ""}
_next = {"local_ip": 0.0}


def _run(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=1).stdout
    except Exception:
        return ""


def _local_ip() -> str:
    m = re.search(r"interface:\s*(\S+)", _run("/sbin/route", "-n", "get", "default"))
    # Default route may be a VPN tunnel (utun*) with no IPv4 → try Wi-Fi/Ethernet too
    ifaces = ([m.group(1)] if m else []) + [f"en{i}" for i in range(5)]
    for iface in ifaces:
        ip = _run("/usr/sbin/ipconfig", "getifaddr", iface).strip()
        if ip:
            return ip
    return ""


def _refresh() -> None:
    now = time.monotonic()

    if now >= _next["local_ip"]:
        _state["local_ip"] = _local_ip()
        _next["local_ip"] = now + LOCAL_IP_SECONDS


def _tick(timer_id: int | None) -> None:
    _refresh()
    for tm in get_boss().all_tab_managers:
        tm.mark_tab_bar_dirty()


_timer_id = None

# ── Rendering ───────────────────────────────────────────────────────────────

# A segment is (name, text, fg, bg); bg None = default segment background
Segment = tuple[str, str, int, int | None]


def _active_window(os_window_id: int):
    boss = get_boss()
    for tm in boss.all_tab_managers:
        if tm.os_window_id == os_window_id:
            return tm.active_window
    return boss.active_window


def _duration(td: datetime.timedelta) -> str:
    mins = int(td.total_seconds() // 60)
    return f"{mins // 60}h{mins % 60:02d}m" if mins >= 60 else f"{mins}m"


def _luminance(rgb: int) -> float:
    def ch(v: int) -> float:
        v /= 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    return 0.2126 * ch(rgb >> 16 & 255) + 0.7152 * ch(rgb >> 8 & 255) + 0.0722 * ch(rgb & 255)


def _readable_on(bg: int) -> int:
    """Theme background or foreground, whichever contrasts more with `bg`."""
    opts = get_options()
    candidates = [color_as_int(opts.background), color_as_int(opts.foreground)]
    lb = _luminance(bg)
    return max(candidates, key=lambda c: (max(_luminance(c), lb) + 0.05) / (min(_luminance(c), lb) + 0.05))


def _parse_time(value: str) -> datetime.datetime | None:
    try:
        t = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    return t if t.tzinfo else t.replace(tzinfo=datetime.timezone.utc)


def _aws_segment(os_window_id: int, c, now) -> Segment | None:
    """`sso <name>` used in the focused split, plus time left on its credentials.

    Hidden in splits where `sso` hasn't been run. The credentials are static env
    vars (no silent refresh), so "expired" means: run `sso <name>` again.
    """
    win = _active_window(os_window_id)
    user_vars = (getattr(win, "user_vars", None) or {}) if win else {}
    name = user_vars.get("aws_sso", "")
    if not name:
        return None

    expires = _parse_time(user_vars.get("aws_expires", ""))
    if expires is None:
        left_text, fg = "", c(2)
    elif expires <= now:
        left_text, fg = "expired", c(1)
    else:
        left = expires - now
        left_text = _duration(left)
        fg = c(3) if left.total_seconds() < CREDS_WARN_MINUTES * 60 else c(2)

    text = f"{ICON_AWS} {name}" + (f" · {left_text}" if left_text else "")
    if PROD_PATTERN.search(name):
        # Prod: solid background (light yellow for prod, red for mprod), impossible
        # to miss; text is the theme's fg or bg, whichever reads better on it
        bg = PROD_BACKGROUNDS.get(name.lower(), c(1))
        return ("aws", text, _readable_on(bg), bg)
    return ("aws", text, fg, None)


def _load_segment(c) -> Segment:
    load = os.getloadavg()[0]
    per_core = load / (os.cpu_count() or 1)
    fg = c(2) if per_core < 0.7 else c(3) if per_core < 1.0 else c(1)
    return ("load", f"{ICON_LOAD} {load:.2f}", fg, None)


def _segments(os_window_id: int) -> list[Segment]:
    opts = get_options()
    c = lambda n: color_as_int(getattr(opts, f"color{n}"))  # noqa: E731
    now = datetime.datetime.now(datetime.timezone.utc)
    parts: dict[str, Segment | None] = {
        "aws": _aws_segment(os_window_id, c, now),
        "load": _load_segment(c),
        "local_ip": ("local_ip", f"{ICON_LAN} {_state['local_ip'] or '–'}", c(4), None),
        "utc": ("utc", f"{ICON_WORLD} {now:%Y-%m-%d %H:%M:%S} UTC", c(6), None),
    }
    return [s for name in SEGMENTS if (s := parts.get(name))]


def _draw_right_status(draw_data: DrawData, screen: Screen) -> None:
    segments = _segments(draw_data.os_window_id)
    bar_bg = as_rgb(color_as_int(draw_data.default_bg))
    seg_bg = color_as_int(draw_data.inactive_bg)

    # Each segment: separator + " text "
    def width(segs):
        return sum(len(s[1]) + 3 for s in segs)

    # Too narrow: hide the least important segments first
    min_x = screen.cursor.x + 2
    for name in DROP_ORDER:
        if screen.columns - width(segments) >= min_x:
            break
        segments = [s for s in segments if s[0] != name]
    if not segments or screen.columns - width(segments) < min_x:
        return

    screen.cursor.x = screen.columns - width(segments)
    for _, text, fg, bg in segments:
        bg = seg_bg if bg is None else bg
        screen.cursor.bg = bar_bg
        screen.cursor.fg = as_rgb(bg)
        screen.draw(SEPARATOR)
        screen.cursor.bg = as_rgb(bg)
        screen.cursor.fg = as_rgb(fg)
        screen.draw(f" {text} ")
    screen.cursor.bg = bar_bg


def draw_tab(
    draw_data: DrawData,
    screen: Screen,
    tab: TabBarData,
    before: int,
    max_title_length: int,
    index: int,
    is_last: bool,
    extra_data: ExtraData,
) -> int:
    global _timer_id
    if _timer_id is None:
        _refresh()
        _timer_id = add_timer(_tick, REFRESH_SECONDS, True)

    end = draw_tab_with_powerline(
        draw_data, screen, tab, before, max_title_length, index, is_last, extra_data
    )
    if is_last and not extra_data.for_layout:
        _draw_right_status(draw_data, screen)
    return end
