# Alacritty Configuration
# Modern GPU-accelerated terminal emulator
# Documentation: https://alacritty.org/config-alacritty.html

# Import additional configuration files
# import = []

[env]
TERM = "xterm-256color"

[window]
# Window dimensions (in character columns/lines)
# dimensions = { columns = 120, lines = 30 }

# Window padding
padding = { x = 10, y = 10 }

# Decorations
decorations = "full"

# Opacity
opacity = 0.95

# Startup mode
startup_mode = "Windowed"

# Window title
title = "Alacritty"

# Dynamic title
dynamic_title = true

# Window class (X11/Wayland)
[window.class]
instance = "Alacritty"
general = "Alacritty"

[scrolling]
# Maximum number of lines in scrollback buffer
history = 10000

# Scrolling distance (lines)
multiplier = 3

[font]
# Normal font
normal = { family = "JetBrains Mono", style = "Regular" }

# Bold font
bold = { family = "JetBrains Mono", style = "Bold" }

# Italic font
italic = { family = "JetBrains Mono", style = "Italic" }

# Bold italic font
bold_italic = { family = "JetBrains Mono", style = "Bold Italic" }

# Font size
size = 13.0

# Offset for better spacing
offset = { x = 0, y = 1 }

# Glyph offset for better alignment
glyph_offset = { x = 0, y = 0 }

# Use built-in font for box drawing characters
builtin_box_drawing = true

# Colors (Tokyo Night theme)
[colors]
[colors.primary]
background = "#1a1b26"
foreground = "#c0caf5"

[colors.normal]
black = "#15161e"
red = "#f7768e"
green = "#9ece6a"
yellow = "#e0af68"
blue = "#7aa2f7"
magenta = "#bb9af7"
cyan = "#7dcfff"
white = "#a9b1d6"

[colors.bright]
black = "#414868"
red = "#f7768e"
green = "#9ece6a"
yellow = "#e0af68"
blue = "#7aa2f7"
magenta = "#bb9af7"
cyan = "#7dcfff"
white = "#c0caf5"

[colors.indexed_colors]
# Add indexed colors if needed

[colors.cursor]
cursor = "#c0caf5"
text = "#1a1b26"

[colors.selection]
background = "#33467c"
text = "CellForeground"

[cursor]
# Cursor style
style = { shape = "Block", blinking = "On" }

# Vi mode cursor style
vi_mode_style = { shape = "Block", blinking = "Off" }

# Blink interval (ms)
blink_interval = 750

# If true, cursor won't blink when window is unfocused
unfocused_hollow = true

# Thickness of the cursor (relative to cell width, from 0.0 to 1.0)
thickness = 0.15

[mouse]
# Hide cursor when typing
hide_when_typing = true

# Click settings
[mouse.bindings]
# Open URLs with Cmd+Click on macOS
# { mouse = "Middle", action = "PasteSelection" }

[selection]
# Save to clipboard on selection
save_to_clipboard = true

# Semantic escape characters
semantic_escape_chars = ",│`|:\"' ()[]{}<>\\t"

[keyboard]
# Keybindings
[[keyboard.bindings]]
key = "V"
mods = "Command"
action = "Paste"

[[keyboard.bindings]]
key = "C"
mods = "Command"
action = "Copy"

[[keyboard.bindings]]
key = "Q"
mods = "Command"
action = "Quit"

[[keyboard.bindings]]
key = "N"
mods = "Command"
action = "CreateNewWindow"

[[keyboard.bindings]]
key = "F"
mods = "Command|Control"
action = "ToggleFullscreen"

[[keyboard.bindings]]
key = "Plus"
mods = "Command"
action = "IncreaseFontSize"

[[keyboard.bindings]]
key = "Minus"
mods = "Command"
action = "DecreaseFontSize"

[[keyboard.bindings]]
key = "Key0"
mods = "Command"
action = "ResetFontSize"

[[keyboard.bindings]]
key = "K"
mods = "Command"
action = "ClearHistory"

[[keyboard.bindings]]
key = "K"
mods = "Command"
chars = "\u000C"

# Vi mode keybindings
[[keyboard.bindings]]
key = "Space"
mods = "Shift|Control"
mode = "~Search"
action = "ToggleViMode"

[bell]
# Visual bell
animation = "EaseOutExpo"
duration = 0
color = "#ffffff"

# Command bell
command = "None"

[debug]
# Display the time it takes to redraw each frame
render_timer = false

# Keep the log file after quitting Alacritty
persistent_logging = false

# Log level
log_level = "Warn"

# Print all received window events
print_events = false
