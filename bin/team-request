#!/usr/bin/env bash
#
# team-request - Automate AWS TEAM elevated access requests via AppSync GraphQL API
#
# Usage: team-request <justification> [duration_hours]
#
# Configuration: <dotfiles>/config/aws.local.sh (gitignored)
#   Copy config/aws.example.sh and fill in the TEAM_* values.
#
# Token: Set TEAM_TOKEN env var, or the script will prompt you to paste it.
#   Get it from: TEAM portal > DevTools > Application > Local Storage > CognitoIdentityServiceProvider.*.idToken
#

set -euo pipefail

# --- Args ---
JUSTIFICATION="${1:?Usage: team-request <justification> [duration_hours]}"
DURATION_HOURS="${2:-4}"

# --- Config ---
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="$DOTFILES_DIR/config/aws.local.sh"
CACHE_DIR="$HOME/.cache/team-request"
TOKEN_FILE="$CACHE_DIR/token"

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info()    { echo -e "${CYAN}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# --- Ensure dependencies ---
for cmd in curl jq; do
  if ! command -v "$cmd" &>/dev/null; then
    error "Required command '$cmd' not found. Please install it."
    exit 1
  fi
done

# --- Load or create config ---
load_config() {
  if [ ! -f "$CONFIG_FILE" ]; then
    error "Config not found: $CONFIG_FILE"
    error "Create it with: cp $DOTFILES_DIR/config/aws.example.sh $CONFIG_FILE"
    exit 1
  fi

  # shellcheck source=/dev/null
  source "$CONFIG_FILE"

  if [ -z "${TEAM_URL:-}" ]; then
    error "Missing required config: TEAM_URL in $CONFIG_FILE"
    exit 1
  fi

  # Auto-discover AppSync URL from TEAM portal if not configured
  if [ -z "${TEAM_APPSYNC_URL:-}" ]; then
    info "Auto-discovering AppSync endpoint from TEAM portal..."
    local js_path
    js_path=$(curl -s "$TEAM_URL" | grep -oE '/static/js/main\.[^"]*\.js' | head -1)
    if [ -n "$js_path" ]; then
      local base_url="${TEAM_URL%%/requests*}"
      TEAM_APPSYNC_URL=$(curl -s "${base_url}${js_path}" | grep -oE 'aws_appsync_graphqlEndpoint:"[^"]*"' | cut -d'"' -f2)
    fi
    if [ -n "$TEAM_APPSYNC_URL" ]; then
      success "Found AppSync endpoint: $TEAM_APPSYNC_URL"
    else
      error "Could not auto-discover AppSync URL. Set TEAM_APPSYNC_URL in $CONFIG_FILE"
    fi
  fi

  # Validate required fields
  local missing=0
  for var in TEAM_APPSYNC_URL TEAM_ACCOUNT_ID TEAM_ACCOUNT_NAME TEAM_PERMSET TEAM_TICKET TEAM_ROLE_ID TEAM_USERNAME TEAM_SSO_PROFILE; do
    if [ -z "${!var:-}" ]; then
      error "Missing required config: $var in $CONFIG_FILE"
      missing=1
    fi
  done
  if [ "$missing" -eq 1 ]; then
    exit 1
  fi

  ACCOUNT_ID="$TEAM_ACCOUNT_ID"
  PERMISSION_SET="$TEAM_PERMSET"
  TICKET_NO="$TEAM_TICKET"
}

# --- Token management ---

# Extract Cognito ID token from Arc browser via AppleScript
extract_token_from_browser() {
  local team_origin="${TEAM_URL%%/requests*}"

  local token
  token=$(osascript 2>/dev/null <<APPLESCRIPT
tell application "System Events"
  if not (exists process "Arc") then return ""
end tell

tell application "Arc"
  -- Search all windows for a TEAM tab by index
  set foundIndex to 0
  set foundWindow to missing value
  repeat with w in windows
    set tabCount to count of tabs of w
    repeat with i from 1 to tabCount
      if URL of tab i of w starts with "${team_origin}" then
        set foundIndex to i
        set foundWindow to w
        exit repeat
      end if
    end repeat
    if foundIndex > 0 then exit repeat
  end repeat

  -- If no TEAM tab, open one and wait for SSO redirect
  if foundIndex = 0 then
    tell front window
      make new tab with properties {URL:"${team_origin}"}
    end tell
    delay 6
    set foundWindow to front window
    set tabCount to count of tabs of foundWindow
    -- Find the newly created tab
    repeat with i from 1 to tabCount
      if URL of tab i of foundWindow starts with "${team_origin}" then
        set foundIndex to i
        exit repeat
      end if
    end repeat
  end if

  if foundIndex = 0 then return ""

  -- Reload the tab to ensure fresh tokens from SSO session
  tell tab foundIndex of foundWindow to reload

  delay 3

  set jsResult to execute tab foundIndex of foundWindow javascript "
    var keys = Object.keys(localStorage);
    var tokenKey = keys.find(function(k) { return k.includes('idToken'); });
    tokenKey ? localStorage.getItem(tokenKey) : '';
  "
  return jsResult
end tell
APPLESCRIPT
  ) || true

  echo "$token"
}

get_token() {
  # 1. Check env var
  if [ -n "${TEAM_TOKEN:-}" ]; then
    echo "$TEAM_TOKEN"
    return
  fi

  # 2. Check cached ID token (valid for 50 minutes)
  if [ -f "$TOKEN_FILE" ]; then
    local token_age
    token_age=$(( $(date +%s) - $(stat -f %m "$TOKEN_FILE" 2>/dev/null || stat -c %Y "$TOKEN_FILE" 2>/dev/null) ))
    if [ "$token_age" -lt 3000 ]; then
      cat "$TOKEN_FILE"
      return
    fi
  fi

  mkdir -p "$CACHE_DIR"

  # 3. Auto-extract from Arc browser
  info "Extracting Cognito ID token from Arc..." >&2
  local token
  token=$(extract_token_from_browser)
  # Strip surrounding quotes added by AppleScript
  token="${token%\"}"
  token="${token#\"}"

  if [ -n "$token" ] && [ "${#token}" -gt 100 ]; then
    echo "$token" > "$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"
    success "Token extracted from Arc (valid ~50 min)" >&2
    echo "$token"
    return
  fi

  # 4. Fallback: manual clipboard paste
  warn "Could not extract token from Arc. Falling back to manual paste." >&2
  info "Opening TEAM portal..." >&2
  open "$TEAM_URL" 2>/dev/null
  echo "" >&2
  echo "  After the page loads:" >&2
  echo "  1. Open DevTools (Cmd+Option+I) > Application > Local Storage" >&2
  echo "  2. Copy the value of the key containing 'idToken'" >&2
  echo "" >&2

  read -rp "Then press Enter to read from clipboard: " _unused
  token="$(pbpaste 2>/dev/null | tr -d '[:space:]')"

  if [ -z "$token" ] || [ "${#token}" -lt 100 ]; then
    error "No valid token in clipboard. Copy the idToken value and retry."
    exit 1
  fi

  echo "$token" > "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  success "Token cached (valid ~50 min)" >&2

  echo "$token"
}

# --- Create the TEAM request via GraphQL ---
create_request() {
  local token="$1"
  # Use local timezone format to match browser behavior
  local start_time
  start_time=$(date +"%Y-%m-%dT%H:%M:%S%z" | sed 's/\([0-9][0-9]\)\([0-9][0-9]\)$/\1:\2/')

  local duration="${DURATION_HOURS}"

  info "Creating TEAM request..." >&2

  local mutation
  mutation=$(cat <<'GQL'
mutation CreateRequests($input: CreateRequestsInput!, $condition: ModelRequestsConditionInput) {
  createRequests(input: $input, condition: $condition) {
    id
    email
    accountId
    accountName
    role
    roleId
    startTime
    duration
    justification
    status
    comment
    username
    approver
    approverId
    approvers
    approver_ids
    revoker
    revokerId
    endTime
    ticketNo
    revokeComment
    session_duration
    createdAt
    updatedAt
    owner
    __typename
  }
}
GQL
)

  # Build the full payload as a single jq call to avoid shell quoting issues
  local payload_file
  payload_file=$(mktemp)
  trap "rm -f '$payload_file'" RETURN

  jq -n \
    --arg query "$mutation" \
    --arg accountId "$ACCOUNT_ID" \
    --arg accountName "$TEAM_ACCOUNT_NAME" \
    --arg role "$PERMISSION_SET" \
    --arg roleId "$TEAM_ROLE_ID" \
    --arg startTime "$start_time" \
    --arg duration "$duration" \
    --arg justification "$JUSTIFICATION" \
    --arg ticketNo "$TICKET_NO" \
    --arg username "${TEAM_USERNAME:-}" \
    '{
      query: $query,
      variables: {
        input: {
          accountId: $accountId,
          accountName: $accountName,
          role: $role,
          roleId: $roleId,
          startTime: $startTime,
          duration: $duration,
          justification: $justification,
          ticketNo: $ticketNo,
          username: $username
        }
      }
    }' > "$payload_file"

  if [ ! -s "$payload_file" ]; then
    error "Failed to build request payload. Check your config values in $CONFIG_FILE"
    return 1
  fi

  local body_file
  body_file=$(mktemp)
  local http_code
  http_code=$(curl -s -o "$body_file" -w "%{http_code}" -X POST "$TEAM_APPSYNC_URL" \
    -H "Authorization: $token" \
    -H "Content-Type: application/json" \
    -d @"$payload_file")
  local body
  body=$(cat "$body_file")
  rm -f "$body_file"

  if [ "$http_code" != "200" ]; then
    error "API request failed (HTTP $http_code)"
    echo "$body"
    if [ "$http_code" = "401" ] || [ "$http_code" = "403" ]; then
      warn "Token may be expired. Delete cached token and retry:"
      warn "  rm $TOKEN_FILE"
    fi
    exit 1
  fi

  # Debug: always show response when it contains errors
  local has_errors
  has_errors=$(echo "$body" | jq -r 'if .errors then "yes" else "no" end' 2>/dev/null || echo "unknown")
  if [ "$has_errors" != "no" ]; then
    error "GraphQL errors. Full response:"
    echo "--- RESPONSE ---"
    echo "$body"
    echo "--- END RESPONSE ---"
    echo ""
    warn "Payload sent:"
    echo "--- PAYLOAD ---"
    cat "$payload_file"
    echo "--- END PAYLOAD ---"
    exit 1
  fi

  local request_id
  request_id=$(echo "$body" | jq -r '.data.createRequests.id')
  local status
  status=$(echo "$body" | jq -r '.data.createRequests.status')

  if [ -z "$request_id" ] || [ "$request_id" = "null" ]; then
    error "Failed to create request. Response:"
    echo "$body" | jq .
    exit 1
  fi

  success "Request created: $request_id (status: $status)" >&2
  echo "$request_id"
}

# --- Poll for request approval ---
poll_request() {
  local token="$1"
  local request_id="$2"
  local max_attempts=30
  local interval=10

  info "Polling for request approval (max ${max_attempts} x ${interval}s)..."

  local query
  query=$(cat <<'GQL'
query GetRequests($id: ID!) {
  getRequests(id: $id) {
    id
    status
    startTime
    duration
    endTime
  }
}
GQL
)

  local poll_payload_file
  poll_payload_file=$(mktemp)
  jq -n --arg query "$query" --arg id "$request_id" \
    '{ query: $query, variables: { id: $id } }' > "$poll_payload_file"

  for i in $(seq 1 $max_attempts); do
    local poll_body_file
    poll_body_file=$(mktemp)
    curl -s -o "$poll_body_file" -X POST "$TEAM_APPSYNC_URL" \
      -H "Authorization: $token" \
      -H "Content-Type: application/json" \
      -d @"$poll_payload_file"

    local status
    status=$(jq -r '.data.getRequests.status // "unknown"' "$poll_body_file" 2>/dev/null)
    rm -f "$poll_body_file"

    case "$status" in
      approved|active|Approved|Active|APPROVED|ACTIVE|"in progress"|"In Progress"|"IN PROGRESS")
        printf "\r%-40s\n" ""
        success "Request $status! (attempt $i/$max_attempts)"
        rm -f "$poll_payload_file"
        return 0
        ;;
      rejected|Rejected|REJECTED)
        error "Request was rejected."
        rm -f "$poll_payload_file"
        return 1
        ;;
      revoked|Revoked|REVOKED)
        error "Request was revoked."
        rm -f "$poll_payload_file"
        return 1
        ;;
      *)
        printf "\r  [%d/%d] Status: %-10s" "$i" "$max_attempts" "$status"
        ;;
    esac

    sleep "$interval"
  done

  rm -f "$poll_payload_file"

  echo ""
  error "Timed out waiting for approval after $((max_attempts * interval))s"
  return 1
}

# --- Activate credentials ---
activate_credentials() {
  local profile="$TEAM_SSO_PROFILE"
  info "Activating credentials for profile: $profile"

  if ! aws sts get-caller-identity --profile "$profile" --output json >/dev/null 2>&1; then
    info "SSO session expired, logging in..."
    aws sso login --profile "$profile"
  fi

  eval "$(aws configure export-credentials --profile "$profile" --format env)"
  success "AWS credentials exported for profile: $profile"
  aws sts get-caller-identity --output table
}

# ===================== Main =====================

load_config

info "Starting TEAM elevated access request..."
echo "  Account:        $ACCOUNT_ID ($TEAM_ACCOUNT_NAME)"
echo "  Permission Set: $PERMISSION_SET"
echo "  Duration:       ${DURATION_HOURS}h"
echo "  Justification:  $JUSTIFICATION"
echo "  Ticket:         $TICKET_NO"
echo ""

token=$(get_token)

request_id=$(create_request "$token")

if poll_request "$token" "$request_id"; then
  echo ""
  activate_credentials
  echo ""
  success "TEAM elevated access is now active!"
else
  error "Failed to get approval. Check the TEAM portal: $TEAM_URL"
  exit 1
fi
