#!/bin/bash
# present menu for user to choose which workspace to open
PS3="Please choose your session: "

# Get a list of Tmux sessions
# while-read, not mapfile: macOS /bin/bash is 3.2
sessions=()
while IFS= read -r s; do sessions+=("$s"); done < <(tmux list-sessions -F "#S" 2>/dev/null)
options=("${sessions[@]}" "New Session")

echo "Available sessions"
echo "------------------"
echo " "

# Use the select loop to present options to the user
select opt in "${options[@]}"
do
	case $opt in
		"New Session")
			read -rp "Enter new session name: " SESSION_NAME
			tmux new -s "$SESSION_NAME"
			break
			;;
		*)
			tmux attach-session -t "$opt"
			break
			;;
	esac
done
